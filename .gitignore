# =====================================================
# PairCode - project-wide Git ignore
# Spring Boot / Maven backend + Vite / React frontend
# Place this file in the PairCode repository root.
# =====================================================

# -------------------------
# Secrets and environment
# -------------------------
.env
.env.*
!.env.example
!.env.sample
!.env.template
**/.env
**/.env.*
!**/.env.example
!**/.env.sample
!**/.env.template

# Private keys, certificates, credentials and local secrets
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
secrets/
**/secrets/
credentials/
**/credentials/

# Local configuration overrides (keep *.example templates)
application-local.properties
application-local.yml
application-local.yaml
application-*.local.properties
application-*.local.yml
application-*.local.yaml

# -------------------------
# Java / Maven / Spring Boot
# -------------------------
target/
**/target/
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*

# Maven generated / local files
.flattened-pom.xml
pom.xml.versionsBackup
.releaseBackup/

# Keep Maven Wrapper files in Git:
# .mvn/wrapper/*, mvnw, mvnw.cmd should NOT be ignored.

# -------------------------
# Node.js / React / Vite
# -------------------------
node_modules/
**/node_modules/
dist/
**/dist/
build/
**/build/
coverage/
**/coverage/
.npm/
.pnpm-store/
.turbo/
.vite/
**/.vite/
*.tsbuildinfo

# Package manager / runtime logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# -------------------------
# Logs, temporary files and caches
# -------------------------
*.log
logs/
**/logs/
tmp/
temp/
.cache/
**/.cache/

# -------------------------
# IDEs and editors
# -------------------------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.example.json
*.iml
.project
.classpath
.settings/

# -------------------------
# Operating system files
# -------------------------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini

# -------------------------
# Local databases and data dumps
# -------------------------
*.sqlite
*.sqlite3
*.db
*.dump
*.sql.gz

# -------------------------
# Test / report output
# -------------------------
*.out
surefire-reports/
**/surefire-reports/
failsafe-reports/
**/failsafe-reports/

# -------------------------
# Generated uploads / user data
# -------------------------
uploads/
**/uploads/
storage/
**/storage/